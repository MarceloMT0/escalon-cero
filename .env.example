# Optional. With no values, the complete practice works in browser demo mode.
# Only public/publishable credentials belong here. Never use service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloud QA additionally requires process-only SUPABASE_TEST_* variables.
# Never put a test admin credential in NEXT_PUBLIC_* or deploy it to Vercel.
